{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Idiom: proportional symbol map. Point marks by lon/lat; circle AREA encodes jobs; hue = coastal/inland. Legend-bound selection filters.",
  "title": {
    "text": "Where tourism employment sits",
    "subtitle": "Direct tourism filled jobs by tourism region, 2024-25. Circle area is proportional to jobs."
  },
  "width": 560,
  "height": 470,
  "projection": {
    "type": "equalEarth",
    "rotate": [
      -134,
      0,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/aus_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eef1f3",
        "stroke": "#fff",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/regions.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lat": "number",
            "lon": "number",
            "tourism_jobs_k_2425": "number"
          }
        }
      },
      "params": [
        {
          "name": "pick",
          "select": {
            "type": "point",
            "fields": [
              "coastal"
            ]
          },
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "circle",
        "stroke": "#fff",
        "strokeWidth": 0.8
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "tourism_jobs_k_2425",
          "type": "quantitative",
          "title": "Tourism jobs ('000)",
          "scale": {
            "range": [
              12,
              1300
            ]
          },
          "legend": {
            "format": ",.0f",
            "symbolFillColor": "#9aa5ab",
            "symbolStrokeWidth": 0
          }
        },
        "color": {
          "field": "coastal",
          "type": "nominal",
          "title": "Region type (click)",
          "scale": {
            "domain": [
              "Coastal",
              "Inland"
            ],
            "range": [
              "#0e6e8c",
              "#c89b5a"
            ]
          }
        },
        "opacity": {
          "condition": {
            "param": "pick",
            "value": 0.82
          },
          "value": 0.07
        },
        "order": {
          "field": "tourism_jobs_k_2425",
          "sort": "descending"
        },
        "tooltip": [
          {
            "field": "region"
          },
          {
            "field": "state"
          },
          {
            "field": "tourism_jobs_k_2425",
            "title": "Jobs ('000)",
            "format": ",.2f"
          }
        ]
      }
    }
  ]
}
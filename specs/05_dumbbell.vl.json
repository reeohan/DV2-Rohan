{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Idiom: dumbbell chart. Two point marks per region joined by a line; horizontal position = spend, hue = visitor type. The gap shows the domestic-international difference.",
  "title": {
    "text": "Domestic travellers drive coastal spending",
    "subtitle": "Overnight visitor spend by type, regional coastal regions ($ million). Open circles mark placeholder rows."
  },
  "width": 500,
  "height": {
    "step": 16
  },
  "data": {
    "url": "data/regions.csv",
    "format": {
      "type": "csv",
      "parse": {
        "dom_spend_m": "number",
        "intl_spend_m": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.coastal === 'Coastal' && datum.capital === 'No' && isValid(datum.intl_spend_m)"
    },
    {
      "fold": [
        "dom_spend_m",
        "intl_spend_m"
      ],
      "as": [
        "k",
        "spend"
      ]
    },
    {
      "calculate": "datum.k === 'dom_spend_m' ? 'Domestic' : 'International'",
      "as": "Visitor type"
    }
  ],
  "encoding": {
    "y": {
      "field": "region",
      "type": "nominal",
      "title": null,
      "sort": {
        "op": "sum",
        "field": "spend",
        "order": "descending"
      },
      "axis": {
        "domain": false,
        "ticks": false,
        "grid": true,
        "gridColor": "#1c3044"
      }
    },
    "x": {
      "field": "spend",
      "type": "quantitative",
      "title": "Spend ($ million)",
      "axis": {
        "grid": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "color": "#3a5268",
        "strokeWidth": 2
      },
      "encoding": {
        "detail": {
          "field": "region",
          "type": "nominal"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "size": 80,
        "strokeWidth": 1.6
      },
      "encoding": {
        "color": {
          "field": "Visitor type",
          "type": "nominal",
          "scale": {
            "domain": [
              "Domestic",
              "International"
            ],
            "range": [
              "#3ee6c4",
              "#ff7b5c"
            ]
          },
          "legend": {
            "orient": "bottom",
            "title": null
          }
        },
        "fill": {
          "condition": {
            "test": "datum.visitor_data_status === 'real'",
            "field": "Visitor type",
            "type": "nominal",
            "scale": {
              "domain": [
                "Domestic",
                "International"
              ],
              "range": [
                "#3ee6c4",
                "#ff7b5c"
              ]
            },
            "legend": null
          },
          "value": "#0c1a28"
        },
        "tooltip": [
          {
            "field": "region"
          },
          {
            "field": "Visitor type"
          },
          {
            "field": "spend",
            "title": "Spend ($m)",
            "format": ",.1f"
          },
          {
            "field": "visitor_data_status",
            "title": "Status"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
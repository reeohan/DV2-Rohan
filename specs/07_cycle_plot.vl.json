{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Idiom: cycle plot. Faceted by month; inside each panel a line runs across years and a rule marks that month's mean. Reading across panels shows seasonality; within a panel, trend.",
  "title": {
    "text": "Seasonality returned before the numbers did",
    "subtitle": "Short-term visitor arrivals to Australia, 2022-2026. Each mini-line runs 2022 (left) to 2026 (right); the flat line is that month's mean."
  },
  "data": {
    "url": "data/arrivals_monthly.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "month": "number",
        "arrivals": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.year>=2022 && datum.year<=2025"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "arrivals",
          "as": "arrivals"
        }
      ],
      "groupby": [
        "year",
        "month"
      ]
    }
  ],
  "facet": {
    "column": {
      "field": "month",
      "type": "ordinal",
      "title": null,
      "header": {
        "labelExpr": "['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][datum.value-1]",
        "labelOrient": "bottom",
        "labelFontWeight": "bold"
      }
    }
  },
  "spacing": 4,
  "spec": {
    "width": 44,
    "height": 250,
    "layer": [
      {
        "mark": {
          "type": "rule",
          "color": "#c89b5a",
          "strokeWidth": 2
        },
        "encoding": {
          "y": {
            "aggregate": "mean",
            "field": "arrivals",
            "type": "quantitative"
          }
        }
      },
      {
        "mark": {
          "type": "line",
          "color": "#0e6e8c",
          "strokeWidth": 2,
          "point": {
            "size": 16,
            "color": "#0e6e8c"
          }
        },
        "encoding": {
          "x": {
            "field": "year",
            "type": "ordinal",
            "axis": null
          },
          "y": {
            "field": "arrivals",
            "type": "quantitative",
            "title": "Arrivals",
            "axis": {
              "format": "~s"
            }
          },
          "tooltip": [
            {
              "field": "year"
            },
            {
              "field": "month"
            },
            {
              "field": "arrivals",
              "format": ","
            }
          ]
        }
      }
    ]
  },
  "config": {
    "view": {
      "stroke": "#e3e7ea",
      "fill": "#fafbfc"
    }
  }
}
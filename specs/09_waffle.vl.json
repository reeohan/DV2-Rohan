{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Idiom: waffle chart (Vega-Lite has no treemap). 100 square marks, one per 1% of marine industry output; hue = sector, with tourism in blues and other industries in neutral tones. Counting squares gives an exact, easy part-to-whole reading.",
  "title": {
    "text": "Tourism is the biggest slice of Australia's marine economy",
    "subtitle": "Marine industry output by sector. Each square = 1%"
  },
  "width": 300,
  "height": 300,
  "data": {
    "url": "data/marine_sectors.csv",
    "format": {
      "type": "csv",
      "parse": {
        "order": "number",
        "share_pct": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "sequence(0, datum.share_pct)",
      "as": "square"
    },
    {
      "flatten": [
        "square"
      ]
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "idx"
        }
      ],
      "sort": [
        {
          "field": "order"
        },
        {
          "field": "square"
        }
      ]
    },
    {
      "calculate": "(datum.idx - 1) % 10",
      "as": "col"
    },
    {
      "calculate": "floor((datum.idx - 1) / 10)",
      "as": "row"
    }
  ],
  "mark": {
    "type": "rect",
    "stroke": "#ffffff",
    "strokeWidth": 3,
    "cornerRadius": 2
  },
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null
    },
    "color": {
      "field": "sector",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "order"
      },
      "scale": {
        "domain": [
          "Domestic marine tourism",
          "International marine tourism",
          "Natural gas",
          "Water transport",
          "Ship and boat building",
          "Fishing and aquaculture",
          "Everything else"
        ],
        "range": [
          "#0e6e8c",
          "#5fb3cc",
          "#8c8c8c",
          "#a9a9a9",
          "#bfbfbf",
          "#d2d2d2",
          "#e3e3e3"
        ]
      },
      "legend": {
        "orient": "right",
        "labelLimit": 220
      }
    },
    "tooltip": [
      {
        "field": "sector",
        "title": "Sector"
      },
      {
        "field": "share_pct",
        "title": "Share of output (%)"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    }
  }
}
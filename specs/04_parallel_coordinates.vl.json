{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Idiom: parallel coordinates. One line per region; each axis a different measure, min-max normalised so they share a vertical position channel.",
  "title": {
    "text": "No two coastal regions look alike",
    "subtitle": "Regional coastal tourism regions across five measures (capitals excluded). Axes run lowest to highest."
  },
  "width": 680,
  "height": 320,
  "data": {
    "url": "data/regions.csv",
    "format": {
      "type": "csv",
      "parse": {
        "visitors_k": "number",
        "nights_k": "number",
        "spend_m": "number",
        "tourism_jobs_k_2425": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.coastal === 'Coastal' && datum.capital === 'No'"
    },
    {
      "calculate": "datum.visitors_k",
      "as": "Visitors (000s)"
    },
    {
      "calculate": "datum.nights_k",
      "as": "Nights (000s)"
    },
    {
      "calculate": "datum.nights_k/datum.visitors_k",
      "as": "Avg stay (nights)"
    },
    {
      "calculate": "datum.spend_m*1000/datum.nights_k",
      "as": "Spend per night ($)"
    },
    {
      "calculate": "datum.tourism_jobs_k_2425",
      "as": "Tourism jobs (000s)"
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "id"
        }
      ]
    },
    {
      "fold": [
        "Visitors (000s)",
        "Nights (000s)",
        "Avg stay (nights)",
        "Spend per night ($)",
        "Tourism jobs (000s)"
      ],
      "as": [
        "measure",
        "value"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "min",
          "field": "value",
          "as": "mn"
        },
        {
          "op": "max",
          "field": "value",
          "as": "mx"
        }
      ],
      "groupby": [
        "measure"
      ]
    },
    {
      "calculate": "(datum.value-datum.mn)/(datum.mx-datum.mn)",
      "as": "norm"
    }
  ],
  "encoding": {
    "x": {
      "field": "measure",
      "type": "nominal",
      "sort": [
        "Visitors (000s)",
        "Nights (000s)",
        "Avg stay (nights)",
        "Spend per night ($)",
        "Tourism jobs (000s)"
      ],
      "axis": {
        "title": null,
        "labelAngle": 0,
        "domain": false,
        "ticks": false,
        "labelFontWeight": "bold",
        "labelPadding": 10
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#c7cdd1"
      },
      "encoding": {
        "detail": {
          "aggregate": "count"
        }
      }
    },
    {
      "params": [
        {
          "name": "ps",
          "select": {
            "type": "point",
            "fields": [
              "state"
            ]
          },
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 1.8
      },
      "encoding": {
        "y": {
          "field": "norm",
          "type": "quantitative",
          "axis": null
        },
        "detail": {
          "field": "id",
          "type": "nominal"
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "title": "State (click)",
          "scale": {
            "scheme": "tableau10"
          }
        },
        "opacity": {
          "condition": {
            "param": "ps",
            "value": 0.8
          },
          "value": 0.08
        },
        "tooltip": [
          {
            "field": "region"
          },
          {
            "field": "measure"
          },
          {
            "field": "value",
            "format": ",.1f"
          },
          {
            "field": "visitor_data_status",
            "title": "Visitor data"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dx": -6,
        "align": "right",
        "baseline": "bottom",
        "color": "#56636b",
        "fontSize": 10
      },
      "encoding": {
        "y": {
          "value": 0
        },
        "text": {
          "aggregate": "max",
          "field": "mx",
          "format": ",.0f"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "dx": -6,
        "align": "right",
        "baseline": "top",
        "color": "#56636b",
        "fontSize": 10
      },
      "encoding": {
        "y": {
          "value": 320
        },
        "text": {
          "aggregate": "min",
          "field": "mn",
          "format": ",.0f"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Idiom: slope chart. Line marks joining two time points; vertical position = tourism jobs indexed to 2023-24 = 100 on a linear scale, so slope = percentage change regardless of region size; hue = direction. Six regional coastal regions spanning the growth range.",
  "title": {
    "text": "Queensland's coast grew, WA's fell",
    "subtitle": [
      "Direct tourism jobs, 2023-24 to 2024-25, indexed (2023-24 = 100).",
      "Six regional coastal regions from the top to the bottom of the range."
    ]
  },
  "width": 300,
  "height": 420,
  "data": {
    "url": "data/regions.csv",
    "format": {
      "type": "csv",
      "parse": {
        "tourism_jobs_k_2324": "number",
        "tourism_jobs_k_2425": "number",
        "jobs_change_pct": "number"
      }
    }
  },
  "transform": [
    {
      "filter": {
        "field": "region",
        "oneOf": [
          "Bundaberg",
          "Mackay Isaac",
          "Gold Coast",
          "Hunter",
          "Australia's South West",
          "Australia's North West"
        ]
      }
    },
    {
      "calculate": "datum.jobs_change_pct>=0 ? 'Grew' : 'Fell'",
      "as": "direction"
    },
    {
      "calculate": "datum.tourism_jobs_k_2324",
      "as": "base"
    },
    {
      "fold": [
        "tourism_jobs_k_2324",
        "tourism_jobs_k_2425"
      ],
      "as": [
        "k",
        "jobs"
      ]
    },
    {
      "calculate": "datum.k === 'tourism_jobs_k_2324' ? '2023-24' : '2024-25'",
      "as": "period"
    },
    {
      "calculate": "datum.jobs/datum.base*100",
      "as": "idx"
    }
  ],
  "encoding": {
    "x": {
      "field": "period",
      "type": "ordinal",
      "title": null,
      "scale": {
        "padding": 0.1
      },
      "axis": {
        "labelAngle": 0,
        "orient": "top",
        "domain": false,
        "ticks": false,
        "labelFontWeight": "bold"
      }
    },
    "color": {
      "field": "direction",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Grew",
          "Fell"
        ],
        "range": [
          "#3ee6c4",
          "#ff7b5c"
        ]
      },
      "legend": {
        "orient": "bottom"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeDash": [
          4,
          4
        ],
        "color": "#8ea3b6",
        "opacity": 0.6
      },
      "encoding": {
        "y": {
          "datum": 100
        },
        "color": {
          "value": "#8ea3b6"
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "point": {
          "size": 70,
          "filled": true
        }
      },
      "encoding": {
        "y": {
          "field": "idx",
          "type": "quantitative",
          "title": "Tourism jobs (2023-24 = 100)",
          "scale": {
            "domain": [
              86,
              118
            ],
            "zero": false,
            "nice": false
          },
          "axis": {
            "values": [
              90,
              95,
              100,
              105,
              110,
              115
            ]
          }
        },
        "detail": {
          "field": "region",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "region"
          },
          {
            "field": "period"
          },
          {
            "field": "jobs",
            "title": "Jobs ('000)",
            "format": ",.2f"
          },
          {
            "field": "jobs_change_pct",
            "title": "Change (%)",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.period === '2024-25'"
        },
        {
          "calculate": "datum.region === \"Australia's South West\" ? datum.idx + 0.7 : datum.region === \"Australia's North West\" ? datum.idx - 0.7 : datum.idx",
          "as": "labelY"
        },
        {
          "calculate": "datum.region + '  ' + format(datum.jobs_change_pct, '+.1f') + '%'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 11
      },
      "encoding": {
        "y": {
          "field": "labelY",
          "type": "quantitative",
          "title": "Tourism jobs (2023-24 = 100)"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}

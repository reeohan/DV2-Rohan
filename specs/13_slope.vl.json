{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Idiom: slope chart. Line marks joining two time points; vertical position = tourism jobs on a log scale, slope = change, hue = direction. Regional coastal regions only. Reproduces TRA's published growth distribution exactly.",
  "title": {
    "text": "Queensland's coast grew, WA's fell",
    "subtitle": [
      "Direct tourism jobs, 2023-24 to 2024-25.",
      "Regional coastal regions, log scale; 12 largest labelled."
    ]
  },
  "width": 300,
  "height": 470,
  "data": {
    "url": "data/regions.csv",
    "format": {
      "type": "csv",
      "parse": {
        "tourism_jobs_k_2324": "number",
        "tourism_jobs_k_2425": "number",
        "jobs_change_pct": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.coastal === 'Coastal' && datum.capital === 'No' && datum.tourism_jobs_k_2425>1"
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "szrank"
        }
      ],
      "sort": [
        {
          "field": "tourism_jobs_k_2425",
          "order": "descending"
        }
      ]
    },
    {
      "calculate": "datum.jobs_change_pct>=0 ? 'Grew' : 'Fell'",
      "as": "direction"
    },
    {
      "fold": [
        "tourism_jobs_k_2324",
        "tourism_jobs_k_2425"
      ],
      "as": [
        "k",
        "jobs"
      ]
    },
    {
      "calculate": "datum.k === 'tourism_jobs_k_2324' ? '2023-24' : '2024-25'",
      "as": "period"
    }
  ],
  "encoding": {
    "x": {
      "field": "period",
      "type": "ordinal",
      "title": null,
      "scale": {
        "padding": 0.1
      },
      "axis": {
        "labelAngle": 0,
        "orient": "top",
        "domain": false,
        "ticks": false,
        "labelFontWeight": "bold"
      }
    },
    "y": {
      "field": "jobs",
      "type": "quantitative",
      "title": "Direct tourism filled jobs ('000)",
      "scale": {
        "type": "log"
      }
    },
    "color": {
      "field": "direction",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Grew",
          "Fell"
        ],
        "range": [
          "#0e6e8c",
          "#9aa5ab"
        ]
      },
      "legend": {
        "orient": "bottom"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 1.8,
        "point": {
          "size": 34,
          "filled": true
        }
      },
      "encoding": {
        "detail": {
          "field": "region",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "region"
          },
          {
            "field": "period"
          },
          {
            "field": "jobs",
            "title": "Jobs ('000)",
            "format": ",.2f"
          },
          {
            "field": "jobs_change_pct",
            "title": "Change (%)",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.period === '2024-25' && datum.szrank<=12"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontSize": 10
      },
      "encoding": {
        "text": {
          "field": "region"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
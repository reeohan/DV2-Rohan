{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Idiom: choropleth map. Area marks (state shapes) + colour lightness. Metric is a ratio, so large states don't dominate on size alone.",
  "title": {
    "text": "Coastal regions hold most of the tourism economy",
    "subtitle": "Share of each state's direct tourism jobs located in coastal tourism regions (RTSA 2024-25)"
  },
  "width": 520,
  "height": 440,
  "data": {
    "url": "data/regions.csv",
    "format": {
      "type": "csv",
      "parse": {
        "tourism_jobs_k_2425": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.coastal === 'Coastal' ? datum.tourism_jobs_k_2425 : 0",
      "as": "cj"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "cj",
          "as": "coastal_jobs"
        },
        {
          "op": "sum",
          "field": "tourism_jobs_k_2425",
          "as": "total_jobs"
        }
      ],
      "groupby": [
        "state"
      ]
    },
    {
      "calculate": "datum.coastal_jobs/datum.total_jobs",
      "as": "coastal_share"
    },
    {
      "lookup": "state",
      "from": {
        "data": {
          "url": "data/aus_states.topojson",
          "format": {
            "type": "topojson",
            "feature": "states"
          }
        },
        "key": "properties.STATE"
      },
      "as": "geo"
    }
  ],
  "projection": {
    "type": "equalEarth",
    "rotate": [
      -134,
      0,
      0
    ]
  },
  "mark": {
    "type": "geoshape",
    "stroke": "#0c1a28",
    "strokeWidth": 1
  },
  "encoding": {
    "shape": {
      "field": "geo",
      "type": "geojson"
    },
    "color": {
      "field": "coastal_share",
      "type": "quantitative",
      "title": [
        "Coastal share of",
        "tourism jobs"
      ],
      "scale": {
        "domain": [
          0,
          1
        ],
        "range": [
          "#1a3550",
          "#1d6a7a",
          "#22a99c",
          "#3ee6c4",
          "#d2fff3"
        ],
        "interpolate": "lab"
      },
      "legend": {
        "format": ".0%",
        "orient": "bottom-left",
        "direction": "horizontal",
        "gradientLength": 150
      }
    },
    "tooltip": [
      {
        "field": "state"
      },
      {
        "field": "coastal_share",
        "format": ".0%"
      },
      {
        "field": "coastal_jobs",
        "title": "Coastal jobs ('000)",
        "format": ",.1f"
      }
    ]
  }
}
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Idiom: Marimekko (mosaic). Rect marks: column WIDTH = each state's share of national tourism jobs, segment HEIGHT = coastal vs inland within that state, so every rectangle's area is its share of the national total. Two stack transforms with normalize.",
  "title": {
    "text": "Coastal regions dominate in almost every state",
    "subtitle": "Column width: state's share of national direct tourism jobs. Column split: coastal vs inland regions (RTSA 2024-25)."
  },
  "width": 620,
  "height": 340,
  "data": {
    "url": "data/regions.csv",
    "format": {
      "type": "csv",
      "parse": {
        "tourism_jobs_k_2425": "number"
      }
    }
  },
  "transform": [
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "tourism_jobs_k_2425",
          "as": "jobs"
        }
      ],
      "groupby": [
        "state",
        "coastal"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "jobs",
          "as": "state_total"
        }
      ],
      "groupby": [
        "state"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "jobs",
          "as": "nat_total"
        }
      ]
    },
    {
      "stack": "jobs",
      "groupby": [],
      "as": [
        "sx1",
        "sx2"
      ],
      "offset": "normalize",
      "sort": [
        {
          "field": "state_total",
          "order": "descending"
        },
        {
          "field": "state",
          "order": "ascending"
        }
      ]
    },
    {
      "window": [
        {
          "op": "min",
          "field": "sx1",
          "as": "x1"
        },
        {
          "op": "max",
          "field": "sx2",
          "as": "x2"
        }
      ],
      "groupby": [
        "state"
      ],
      "frame": [
        null,
        null
      ]
    },
    {
      "stack": "jobs",
      "groupby": [
        "state"
      ],
      "as": [
        "y1",
        "y2"
      ],
      "offset": "normalize",
      "sort": [
        {
          "field": "coastal",
          "order": "ascending"
        }
      ]
    },
    {
      "calculate": "datum.jobs/datum.state_total",
      "as": "share_state"
    },
    {
      "calculate": "datum.state_total/datum.nat_total",
      "as": "state_share"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#fff",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "x1",
          "type": "quantitative",
          "title": "Share of national tourism jobs",
          "axis": {
            "format": ".0%",
            "grid": false
          }
        },
        "x2": {
          "field": "x2"
        },
        "y": {
          "field": "y1",
          "type": "quantitative",
          "title": "Share of state tourism jobs",
          "axis": {
            "format": ".0%",
            "grid": false
          }
        },
        "y2": {
          "field": "y2"
        },
        "color": {
          "field": "coastal",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Coastal",
              "Inland"
            ],
            "range": [
              "#0e6e8c",
              "#c89b5a"
            ]
          },
          "legend": {
            "orient": "top"
          }
        },
        "tooltip": [
          {
            "field": "state"
          },
          {
            "field": "coastal"
          },
          {
            "field": "jobs",
            "title": "Jobs ('000)",
            "format": ",.1f"
          },
          {
            "field": "share_state",
            "title": "Share of state",
            "format": ".0%"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "min",
              "field": "x1",
              "as": "x1"
            },
            {
              "op": "max",
              "field": "x2",
              "as": "x2"
            },
            {
              "op": "max",
              "field": "state_share",
              "as": "ss"
            }
          ],
          "groupby": [
            "state"
          ]
        },
        {
          "calculate": "(datum.x1+datum.x2)/2",
          "as": "xc"
        },
        {
          "filter": "datum.ss>=0.02"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "top",
        "dy": 4,
        "fontWeight": "bold",
        "fontSize": 11,
        "color": "#fff"
      },
      "encoding": {
        "x": {
          "field": "xc",
          "type": "quantitative"
        },
        "y": {
          "datum": 1
        },
        "text": {
          "field": "state"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
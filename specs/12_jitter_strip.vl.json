{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Idiom: jittered strip plot (beeswarm-style; a true beeswarm needs Vega's force transform). Point marks with a deterministic pseudo-random yOffset so dots don't overlap. Log scale keeps the capitals from flattening everything else.",
  "title": {
    "text": "Coastal regions hold 87% of Australia's tourism jobs",
    "subtitle": "Direct tourism filled jobs by region, 2024-25, log scale. Labels mark the five largest."
  },
  "width": 620,
  "height": {
    "step": 120
  },
  "data": {
    "url": "data/regions.csv",
    "format": {
      "type": "csv",
      "parse": {
        "tourism_jobs_k_2425": "number"
      }
    }
  },
  "transform": [
    {
      "window": [
        {
          "op": "row_number",
          "as": "i"
        }
      ]
    },
    {
      "calculate": "((datum.i*9301+49297)%233280)/233280-0.5",
      "as": "jit"
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "rk"
        }
      ],
      "sort": [
        {
          "field": "tourism_jobs_k_2425",
          "order": "descending"
        }
      ]
    }
  ],
  "encoding": {
    "x": {
      "field": "tourism_jobs_k_2425",
      "type": "quantitative",
      "title": "Direct tourism filled jobs ('000)",
      "scale": {
        "type": "log"
      }
    },
    "y": {
      "field": "coastal",
      "type": "nominal",
      "title": null,
      "axis": {
        "labelFontWeight": "bold",
        "labelFontSize": 12,
        "domain": false,
        "ticks": false
      }
    },
    "yOffset": {
      "field": "jit",
      "type": "quantitative",
      "scale": {
        "domain": [
          -0.5,
          0.5
        ]
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "circle",
        "size": 95,
        "opacity": 0.82,
        "stroke": "#0c1a28",
        "strokeWidth": 0.8
      },
      "encoding": {
        "color": {
          "field": "coastal",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Coastal",
              "Inland"
            ],
            "range": [
              "#3ee6c4",
              "#ff7b5c"
            ]
          }
        },
        "tooltip": [
          {
            "field": "region"
          },
          {
            "field": "state"
          },
          {
            "field": "tourism_jobs_k_2425",
            "title": "Jobs ('000)",
            "format": ",.2f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.rk<=5"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontSize": 10,
        "color": "#f4f7fa"
      },
      "encoding": {
        "text": {
          "field": "region"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Idiom: waffle chart. 100 square marks, one per 1% of output, built with sequence() and flatten(); hue groups tourism against everything else. Counting squares gives an exact part-to-whole reading.",
  "title": {
    "text": "Tourism is the sea's second-biggest earner",
    "subtitle": [
      "Marine industry output by sector, FY23 (AIMS 2025).",
      "Each square = 1% of $228.8 billion."
    ]
  },
  "width": 300,
  "height": 300,
  "data": {
    "url": "data/marine_sectors.csv",
    "format": {
      "type": "csv",
      "parse": {
        "order": "number",
        "share_pct": "number",
        "output_m_fy23": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "sequence(0,datum.share_pct)",
      "as": "sq"
    },
    {
      "flatten": [
        "sq"
      ]
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "i"
        }
      ],
      "sort": [
        {
          "field": "order"
        },
        {
          "field": "sq"
        }
      ]
    },
    {
      "calculate": "(datum.i-1)%10",
      "as": "col"
    },
    {
      "calculate": "floor((datum.i-1)/10)",
      "as": "row"
    }
  ],
  "mark": {
    "type": "rect",
    "stroke": "#fff",
    "strokeWidth": 3,
    "cornerRadius": 2
  },
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null
    },
    "color": {
      "field": "sector",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "order"
      },
      "scale": {
        "domain": [
          "Natural gas, offshore oil exploration & extraction",
          "Marine tourism & recreational activities",
          "Marine safety & environment management",
          "Water transport",
          "Marine infrastructure services",
          "Fishing"
        ],
        "range": [
          "#8c8c8c",
          "#0e6e8c",
          "#c6c6c6",
          "#b0b0b0",
          "#d8d8d8",
          "#e8e8e8"
        ]
      },
      "legend": {
        "orient": "right",
        "labelLimit": 250
      }
    },
    "tooltip": [
      {
        "field": "sector"
      },
      {
        "field": "output_m_fy23",
        "title": "Output ($m)",
        "format": ","
      },
      {
        "field": "share_pct",
        "title": "Share (%)"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    }
  }
}